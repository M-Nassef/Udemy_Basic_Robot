<launch>
    <!-- Define the path to the URDF file using xacro -->
    <let name="urdf_path" value="$(find-pkg-share my_robot_description)/urdf/my_robot.urdf.xacro"/>
   
    <!-- Define the path to the configuration file -->
    <let name="rviz_config_path" value="$(find-pkg-share my_robot_description)/rviz/my_robot_urdf_config.rviz"/>

    <!-- Node to launch robot_state_publisher -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher">
        <!-- Pass the robot description to the node using xacro command -->
        <param name="robot_description" 
               value="$(command 'xacro $(var urdf_path)')" />
    </node>

    <!-- Node to launch joint_state_publisher_gui -->
    <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" name="joint_state_publisher_gui"/>

    <!-- Node to launch RViz -->
    <node pkg="rviz2" exec="rviz2" output="screen" name="rviz" args="-d $(var rviz_config_path)"/>
</launch>
